// Sub Net Shopping — database schema.
// Phase 1 (Core Foundation) per PRD §22/§24. Orders, payments, delivery
// assignments, rider earnings and payouts arrive with later phases as new
// migrations; everything here is shaped so they attach without rework.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity & access ────────────────────────────────────────────────

enum Role {
  CUSTOMER
  SUPERMARKET
  RIDER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

/// Approval lifecycle shared by supermarkets and riders (PRD §7, §15).
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id             String        @id @default(cuid())
  role           Role
  firstName      String
  lastName       String
  email          String        @unique
  /// E.164 form, e.g. +2348031234567
  phone          String        @unique
  passwordHash   String
  status         AccountStatus @default(ACTIVE)
  /// Bumped to invalidate every existing session for this user.
  sessionVersion Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer      Customer?
  rider         Rider?
  staffRoles    SupermarketStaff[]
  ownedMarkets  Supermarket[]      @relation("SupermarketOwner")
  notifications Notification[]
  activity      ActivityLog[]      @relation("ActivityActor")
  cartItems     CartItem[]
  orders        Order[]            @relation("CustomerOrders")
  orderEvents   OrderEvent[]

  @@index([role, status])
}

model Customer {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress String?
  createdAt      DateTime @default(now())
}

// ─── Supermarkets ─────────────────────────────────────────────────────

model Supermarket {
  id           String         @id @default(cuid())
  ownerId      String
  owner        User           @relation("SupermarketOwner", fields: [ownerId], references: [id])
  status       ApprovalStatus @default(PENDING)
  statusReason String?

  name               String
  contactName        String
  phone              String
  email              String
  address            String
  area               String?
  latitude           Float?
  longitude          Float?
  /// CAC registration number or similar.
  registrationNumber String?
  description        String?
  logoUrl            String?

  // Store schedule lives in SupermarketHours; these are the extra cut-offs.
  /// "HH:MM" — no new orders after this time.
  lastOrderTime String?

  pickupEnabled Boolean @default(true)
  pickupStart   String? // "HH:MM"
  pickupEnd     String?

  deliveryEnabled       Boolean @default(false)
  deliveryStart         String?
  deliveryEnd           String?
  lastDeliveryOrderTime String?

  // Temporary operational overrides (PRD §6, §19).
  temporarilyClosed   Boolean   @default(false)
  closureNote         String?
  deliveryPausedUntil DateTime?
  pickupPausedUntil   DateTime?

  // POS / inventory integration (PRD §9). One integration per store for now.
  posProvider         String?
  posHasApi           Boolean?
  posIntegrationNotes String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  hours           SupermarketHours[]
  staff           SupermarketStaff[]
  images          SupermarketImage[]
  inventory       Inventory[]
  posSyncs        PosSyncRun[]
  createdProducts Product[]          @relation("ProductCreator")
  productImages   ProductImage[]
  orders          Order[]

  @@index([status])
}

model SupermarketHours {
  id            String      @id @default(cuid())
  supermarketId String
  supermarket   Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek     Int
  isOpen        Boolean     @default(true)
  opensAt       String? // "HH:MM"
  closesAt      String?

  @@unique([supermarketId, dayOfWeek])
}

model SupermarketImage {
  id            String      @id @default(cuid())
  supermarketId String
  supermarket   Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  url           String
  storageKey    String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
}

enum StaffRole {
  MANAGER
  STAFF
}

model SupermarketStaff {
  id            String      @id @default(cuid())
  supermarketId String
  supermarket   Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          StaffRole   @default(STAFF)
  createdAt     DateTime    @default(now())

  @@unique([supermarketId, userId])
}

// ─── Riders ───────────────────────────────────────────────────────────

enum VehicleType {
  MOTORCYCLE
  CAR
  VAN
  BULKY
}

model Rider {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         ApprovalStatus @default(PENDING)
  statusReason   String?
  vehicleType    VehicleType
  plateNumber    String
  vehicleMake    String?
  vehicleColor   String?
  driversLicense String?
  isOnline       Boolean        @default(false)
  lastOnlineAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  approvedAt     DateTime?

  @@index([status, isOnline])
}

// ─── Catalogue & inventory foundation (PRD §8, §9) ────────────────────
// A Product is the platform-wide identity of an item (name, barcode,
// images). Inventory is a supermarket's price and stock for that product,
// so the same item can be compared across stores and its images survive
// price/stock changes.

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  /// Emoji shown on category tiles, e.g. "🥛".
  icon      String?
  sortOrder Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

model Product {
  id                     String       @id @default(cuid())
  name                   String
  brand                  String?
  /// Pack size, e.g. "1 kg", "50cl", "x30".
  unit                   String?
  barcode                String?      @unique
  description            String?
  categoryId             String?
  category               Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Bulky items need a suitable vehicle (PRD §14).
  isBulky                Boolean      @default(false)
  /// The supermarket that created this catalogue entry. Only it (or an
  /// admin) may edit the shared details other stores also sell under.
  createdBySupermarketId String?
  createdBySupermarket   Supermarket? @relation("ProductCreator", fields: [createdBySupermarketId], references: [id], onDelete: SetNull)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  images    ProductImage[]
  inventory Inventory[]

  @@index([name])
  @@index([categoryId])
}

model ProductImage {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Owning store when a supermarket uploaded it; null for shared images.
  supermarketId String?
  supermarket   Supermarket? @relation(fields: [supermarketId], references: [id], onDelete: SetNull)
  url           String
  storageKey    String
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([productId, sortOrder])
}

enum InventorySource {
  MANUAL
  CSV_IMPORT
  POS_SYNC
}

enum Availability {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  UNAVAILABLE
}

model Inventory {
  id            String          @id @default(cuid())
  supermarketId String
  supermarket   Supermarket     @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The store's own SKU / product code.
  sku           String
  /// Price in kobo to avoid floating-point money.
  priceKobo     Int
  stockQuantity Int?
  availability  Availability    @default(IN_STOCK)
  source        InventorySource @default(MANUAL)
  externalRef   String?
  lastSyncedAt  DateTime?
  updatedAt     DateTime        @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([supermarketId, sku])
  @@unique([supermarketId, productId])
  @@index([productId])
}

enum PosSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model PosSyncRun {
  id            String        @id @default(cuid())
  supermarketId String
  supermarket   Supermarket   @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  provider      String
  status        PosSyncStatus @default(RUNNING)
  itemsSeen     Int           @default(0)
  itemsUpdated  Int           @default(0)
  error         String?
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
}

// ─── Cart & orders (PRD §10, Phase 3) ─────────────────────────────────

/// A customer's basket. Items can come from several supermarkets; each
/// supermarket's items check out as a separate order.
model CartItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  quantity    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, inventoryId])
}

enum OrderStatus {
  PLACED
  CONFIRMED
  READY_FOR_PICKUP
  COLLECTED
  CANCELLED
}

enum Fulfilment {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  /// Paid at the supermarket on collection (until online payment, Phase 4).
  PAY_AT_STORE
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  /// Human-friendly reference shown to customers and staff, e.g. SN-4821937.
  number          String        @unique
  customerId      String
  customer        User          @relation("CustomerOrders", fields: [customerId], references: [id])
  supermarketId   String
  supermarket     Supermarket   @relation(fields: [supermarketId], references: [id])
  status          OrderStatus   @default(PLACED)
  fulfilment      Fulfilment    @default(PICKUP)
  paymentMethod   PaymentMethod @default(PAY_AT_STORE)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotalKobo    Int
  deliveryFeeKobo Int           @default(0)
  totalKobo       Int
  customerNote    String?
  /// Client-generated key so a double-submitted checkout creates one order.
  checkoutKey     String        @unique
  cancelReason    String?
  placedAt        DateTime      @default(now())
  confirmedAt     DateTime?
  readyAt         DateTime?
  collectedAt     DateTime?
  cancelledAt     DateTime?
  updatedAt       DateTime      @updatedAt

  items  OrderItem[]
  events OrderEvent[]

  @@index([customerId, placedAt])
  @@index([supermarketId, status, placedAt])
}

/// A line on an order, with name and price copied at checkout so history
/// stays accurate when the catalogue changes.
model OrderItem {
  id                String     @id @default(cuid())
  orderId           String
  order             Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryId       String?
  inventory         Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  productId         String?
  name              String
  unit              String?
  sku               String
  unitPriceKobo     Int
  /// What the customer asked for.
  requestedQuantity Int
  /// What the store will supply; the store can lower it before confirming.
  quantity          Int
  lineTotalKobo     Int
  /// Whether stock was reserved (only for listings that track stock).
  stockReserved     Boolean    @default(false)
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

// ─── Platform ─────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Admin-configurable key/value settings, e.g. commission rates (PRD §17, §18).
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}
