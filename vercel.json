{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/tick?run=payouts",
      "schedule": "0 21 * * *"
    }
  ]
}
