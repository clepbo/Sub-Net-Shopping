# PostgreSQL connection string
DATABASE_URL="postgresql://subnet:subnet@localhost:5432/subnet?schema=public"

# Signs session cookies. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Where uploaded images are stored by the local storage driver (default ./uploads)
# UPLOAD_DIR="/var/lib/subnet/uploads"
# STORAGE_DRIVER="local"

# On Vercel these are set for you by the integrations:
# DATABASE_URL_UNPOOLED=""   # direct connection, used for migrations (Neon)
# BLOB_READ_WRITE_TOKEN=""   # Vercel Blob; switches image storage to Blob
