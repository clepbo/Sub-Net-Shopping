# PostgreSQL connection string
DATABASE_URL="postgresql://subnet:subnet@localhost:5432/subnet?schema=public"

# Signs session cookies. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Where uploaded images are stored by the local storage driver (default ./uploads)
# UPLOAD_DIR="/var/lib/subnet/uploads"
# STORAGE_DRIVER="local"

# On Vercel these are set for you by the integrations:
# DATABASE_URL_UNPOOLED=""   # direct connection, used for migrations (Neon)
# BLOB_READ_WRITE_TOKEN=""   # Vercel Blob; switches image storage to Blob

# Public site URL, used for Paystack's callback and pickup QR codes.
# Optional on Vercel (falls back to the request's host), but set it in production.
# APP_URL="https://subnet.example.com"

# Paystack (https://dashboard.paystack.com/#/settings/developers).
# Without it, checkout only offers "pay at the store".
# PAYSTACK_SECRET_KEY="sk_test_..."
# For local development without a Paystack account, run `npm run paystack:mock`
# and set PAYSTACK_SECRET_KEY="sk_test_local" and PAYSTACK_BASE_URL="http://localhost:4010".
# PAYSTACK_BASE_URL=""

# Protects /api/cron/expire-payments; Vercel Cron sends it automatically.
# CRON_SECRET=""
