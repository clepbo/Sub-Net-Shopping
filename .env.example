# PostgreSQL connection string
DATABASE_URL="postgresql://subnet:subnet@localhost:5432/subnet?schema=public"

# Signs session cookies. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Where uploaded images are stored by the local storage driver (default ./uploads)
# UPLOAD_DIR="/var/lib/subnet/uploads"
# STORAGE_DRIVER="local"

# On Vercel these are set for you by the integrations:
# DATABASE_URL_UNPOOLED=""   # direct connection, used for migrations (Neon)
# BLOB_READ_WRITE_TOKEN=""   # Vercel Blob; switches image storage to Blob

# Public site URL, used for Paystack's callback and pickup QR codes.
# Optional on Vercel (falls back to the request's host), but set it in production.
# APP_URL="https://subnet.example.com"

# Paystack (https://dashboard.paystack.com/#/settings/developers).
# Without it, checkout only offers "pay at the store".
# PAYSTACK_SECRET_KEY="sk_test_..."
# For local development without a Paystack account, run `npm run paystack:mock`
# and set PAYSTACK_SECRET_KEY="sk_test_local" and PAYSTACK_BASE_URL="http://localhost:4010".
# PAYSTACK_BASE_URL=""

# Protects /api/cron/expire-payments; Vercel Cron sends it automatically.
# CRON_SECRET=""

# Phone notifications (web push). Generate with `npm run push:keys`.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@yourdomain.com"

# Email for password reset links (https://resend.com, also on the Vercel Marketplace).
# Without it, reset emails are printed to the server log instead of sent.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="SubNet Shopping <no-reply@yourdomain.com>"   # must be a domain verified in Resend

# Shown on legal pages and the "waiting for approval" screen.
# NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"

# Monnify (https://app.monnify.com → Developers). Used for checkout, riders'
# virtual accounts for paying in cash, refunds and (with the wallet account
# number) the nightly 10 PM supermarket payouts. Sandbox by default.
# MONNIFY_API_KEY="MK_TEST_..."
# MONNIFY_SECRET_KEY="..."
# MONNIFY_CONTRACT_CODE="..."
# MONNIFY_WALLET_ACCOUNT_NUMBER="..."   # the Monnify wallet payouts are sent from
# MONNIFY_BASE_URL="https://api.monnify.com"   # live; omit for sandbox
# For local development run `npm run monnify:mock` and set MONNIFY_BASE_URL="http://localhost:4020",
# MONNIFY_API_KEY="MK_TEST", MONNIFY_SECRET_KEY="mock-secret", MONNIFY_CONTRACT_CODE="1234567890".

# Which provider takes payments and sends payouts when both are configured:
# "monnify" or "paystack" (payouts also accept "manual").
# PAYMENT_PROVIDER="monnify"
# PAYOUT_PROVIDER="monnify"
